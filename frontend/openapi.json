  "components": {
    "schemas": {
      "AggregatedOverviewResponseDto": {
        "type": "object",
        "properties": {
          "units": {
            "$ref": "#/components/schemas/MeasurementUnitsDto"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SampleDto"
            }
          }
        }
      },
      "AggregatedTrendResponseDto": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "group": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TrendSampleDto"
              }
            ]
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "average": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "granularity": {
            "type": [
              "null",
              "string"
            ]
          },
          "points": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/TrendPointDto"
            }
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AggregationFunction": {
        "type": "integer"
      },
      "CombinedExposureBucketDto": {
        "type": "object",
        "properties": {
